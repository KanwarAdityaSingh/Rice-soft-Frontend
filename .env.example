# API root (no trailing slash). Often includes `/v1` — service paths must not add `/v1` again.
# Dev: omit this to use the Vite proxy (/api/v1 → localhost:3000) so refresh cookies work.
# Example (direct backend, no proxy): http://localhost:3000/api/v1
# VITE_API_BASE_URL=http://localhost:3000/api/v1

# Optional: if the app is served under a subpath (e.g. https://yourdomain.com/app)
# VITE_PUBLIC_BASE_PATH=/app
